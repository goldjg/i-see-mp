{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": "src",
    "composite": true,
    "paths": {
      "@iseemp/core": ["../core/src/index.ts"],
      "@iseemp/storage": ["../storage/src/index.ts"],
      "@iseemp/collector": ["../collector/src/index.ts"],
      "@iseemp/graph": ["../graph/src/index.ts"],
      "@iseemp/rules": ["../rules/src/index.ts"],
      "@iseemp/api": ["../../apps/api/src/server.ts"]
    }
  },
  "references": [
    { "path": "../core" },
    { "path": "../storage" },
    { "path": "../collector" },
    { "path": "../graph" },
    { "path": "../rules" },
    { "path": "../../apps/api" }
  ],
  "include": ["src"]
}
