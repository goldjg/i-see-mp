{
  "name": "iseemp",
  "version": "0.0.1",
  "private": true,
  "description": "ISeeMP — execution path analysis engine for AI systems",
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "scripts": {
    "iseemp": "node packages/cli/dist/index.js",
    "build": "pnpm -r --filter='./packages/*' --filter='./apps/api' --filter='./apps/web' build",
    "test": "vitest run",
    "lint": "eslint .",
    "typecheck": "tsc -b tsconfig.json",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@iseemp/cli": "workspace:*",
    "@testing-library/react": "^16.3.2",
    "@typescript-eslint/eslint-plugin": "^8.59.1",
    "@typescript-eslint/parser": "^8.59.1",
    "@vitest/coverage-v8": "^4.1.5",
    "eslint": "^10.3.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.8.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.1",
    "vitest": "^4.1.5"
  }
}
