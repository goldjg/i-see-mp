{
  "name": "iseemp",
  "version": "0.0.1",
  "private": true,
  "description": "ISeeMP — execution path analysis engine for AI systems",
  "engines": { "node": ">=20", "pnpm": ">=9" },
  "scripts": {
    "iseemp": "node packages/cli/dist/index.js",
    "build": "pnpm -r --filter='./packages/*' --filter='./apps/api' --filter='./apps/web' build",
    "test": "vitest run",
    "lint": "eslint .",
    "typecheck": "tsc -b tsconfig.json",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@iseemp/cli": "workspace:*",
    "@eslint/js": "^9.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.0.0",
    "prettier": "^3.0.0",
    "typescript": "^5.4.0",
    "vitest": "^3.0.0",
    "@vitest/coverage-v8": "^3.0.0",
    "typescript-eslint": "^8.0.0"
  }
}
