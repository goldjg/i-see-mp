{
  "name": "iseemp",
  "version": "0.0.1",
  "private": true,
  "description": "ISeeMP — execution path analysis engine for AI systems",
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "pnpm": {
    "overrides": {
      "express-rate-limit@8>ip-address": "^10.7.4",
      "vitest@3>vite": "^7.3.7",
      "vite-node@3>vite": "^7.3.7"
    }
  },
  "scripts": {
    "iseemp": "node packages/cli/dist/index.js",
    "build": "pnpm -r --filter='./packages/*' --filter='./apps/api' --filter='./apps/web' build",
    "test": "vitest run",
    "lint": "eslint .",
    "typecheck": "tsc -b tsconfig.json",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@iseemp/cli": "workspace:*",
    "@testing-library/react": "^16.3.3",
    "@typescript-eslint/eslint-plugin": "^8.72.0",
    "@typescript-eslint/parser": "^8.72.0",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^9.39.4",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^3.2.7"
  }
}
